{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "medguard-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },

  "d1_databases": [
    {
      // The binding is the variable name on `env`, not the database name — the code and the
      // generated types use `env.DB`.
      "binding": "DB",
      "database_name": "medguard",
      // Tests never touch this id: vitest-pool-workers provisions an isolated local D1 per
      // test file, so the suite runs with no account and no network.
      "database_id": "10682a81-c052-4465-975f-e22efca55588",
      "migrations_dir": "migrations"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "HOUSEHOLD",
        "class_name": "HouseholdDO"
      }
    ]
  },

  // CRITICAL: new_sqlite_classes, not new_classes.
  // KV-backed Durable Objects require a paid Workers plan; SQLite-backed ones run on free.
  // Changing this after the fact costs a migration, so it is correct from the first commit.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["HouseholdDO"]
    }
  ]
}
