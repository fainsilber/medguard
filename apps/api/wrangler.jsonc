{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "medguard-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },

  // VAPID_PRIVATE_KEY is NOT here — it's set as a Worker secret (`wrangler secret put`), never
  // committed. These two are safe to commit: the public key is sent to every subscribing
  // browser anyway, and the subject is just a contact URL for push services.
  "vars": {
    "VAPID_PUBLIC_KEY": "BClH7AYsOuNPIJT7EunVl1-7qAGppjDCYACqIA5FF6W54KUrhthYY1xwGxumg-LuWQFK2cLpvqdGkwSzL4DO0z0",
    "VAPID_SUBJECT": "mailto:medguard@fainsilber.co.il"
  },

  "d1_databases": [
    {
      // The binding is the variable name on `env`, not the database name — the code and the
      // generated types use `env.DB`.
      "binding": "DB",
      "database_name": "medguard",
      // Tests never touch this id: vitest-pool-workers provisions an isolated local D1 per
      // test file, so the suite runs with no account and no network.
      "database_id": "10682a81-c052-4465-975f-e22efca55588",
      "migrations_dir": "migrations"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "HOUSEHOLD",
        "class_name": "HouseholdDO"
      }
    ]
  },

  // CRITICAL: new_sqlite_classes, not new_classes.
  // KV-backed Durable Objects require a paid Workers plan; SQLite-backed ones run on free.
  // Changing this after the fact costs a migration, so it is correct from the first commit.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["HouseholdDO"]
    }
  ]
}
