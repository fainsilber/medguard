{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "noEmit": true,
    // Runtime types come from worker-configuration.d.ts, generated by `npm run cf-typegen`.
    // Regenerate it whenever wrangler.jsonc bindings change; it is committed so CI can
    // typecheck without a Cloudflare login.
    "types": ["@cloudflare/vitest-pool-workers/types"],
    "paths": {
      "@medguard/shared": ["../../packages/shared/src/index.ts"],
      "@medguard/shared/testing": ["../../packages/shared/src/testing.ts"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "*.config.ts", "worker-configuration.d.ts"]
}
