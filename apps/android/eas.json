{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "MEDGUARD_API_BASE_URL": "https://medguard-api-dev.example.workers.dev"
      }
    },
    "internal": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "MEDGUARD_API_BASE_URL": "https://medguard-api.example.workers.dev"
      },
      "channel": "internal-testing"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "MEDGUARD_API_BASE_URL": "https://medguard-api.example.workers.dev"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
