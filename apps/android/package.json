{
  "name": "@medguard/android",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "//test": "The root's `npm test`/`npm run test:coverage` call `test:jest` here, not `test` — this workspace's own `test` (vitest run && jest) exists for running the whole app's suite standalone, but the vitest half is the same `android` project the root vitest.config.ts already runs. Adding `--workspaces` to a root script would silently double-run those 76+ tests.",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && jest",
    "test:watch": "vitest",
    "test:jest": "jest"
  },
  "dependencies": {
    "@medguard/shared": "*",
    "@medguard/store": "*",
    "@react-navigation/bottom-tabs": "^7.18.15",
    "@react-navigation/native": "^7.3.15",
    "@react-navigation/native-stack": "^7.18.7",
    "expo": "~57.0.10",
    "expo-asset": "~57.0.9",
    "expo-application": "~57.0.2",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-modules-core": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.10",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "^5.8.1",
    "react-native-screens": "^4.26.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.5",
    "better-sqlite3": "^13.0.3",
    "jest": "^30.4.2",
    "jest-expo": "^57.0.3",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "expo": {
    "autolinking": {
      "searchPaths": [
        "./modules"
      ]
    }
  }
}
