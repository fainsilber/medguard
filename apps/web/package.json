{
  "name": "@medguard/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "//optionalDependencies": "Tailwind v4 compiles CSS with lightningcss, whose platform binaries ship as optional deps. npm prunes non-matching optional deps from the lockfile on every install/uninstall (npm/cli#4828), which breaks `vite build` locally and `npm ci` on other platforms in CI. Listing lightningcss's full platform set as DIRECT optional deps keeps every entry in the lockfile permanently; npm still installs only the one matching the host, and skips the rest on os/cpu mismatch.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@medguard/shared": "*",
    "@medguard/store": "*",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "workbox-precaching": "^7.3.0",
    "workbox-window": "^7.3.0"
  },
  "optionalDependencies": {
    "lightningcss-android-arm64": "1.32.0",
    "lightningcss-darwin-arm64": "1.32.0",
    "lightningcss-darwin-x64": "1.32.0",
    "lightningcss-freebsd-x64": "1.32.0",
    "lightningcss-linux-arm-gnueabihf": "1.32.0",
    "lightningcss-linux-arm64-gnu": "1.32.0",
    "lightningcss-linux-arm64-musl": "1.32.0",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-linux-x64-musl": "1.32.0",
    "lightningcss-win32-arm64-msvc": "1.32.0",
    "lightningcss-win32-x64-msvc": "1.32.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "wrangler": "^4.118.0"
  }
}
